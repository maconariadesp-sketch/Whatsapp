# ================== Painel ==================
PORT=3000
# Senha para entrar no painel de conversas (obrigatória)
ADMIN_PASSWORD=
# Opcional: se vazio, um segredo aleatório é gerado e salvo em data/session-secret
SESSION_SECRET=

# ================== IA (Claude) ==================
# Crie a chave em https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo padrão: claude-opus-5-5. Para reduzir custo, troque por claude-sonnet-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# Esforço de raciocínio: low | medium | high
ANTHROPIC_EFFORT=medium
# Espera alguns segundos para juntar mensagens seguidas do cliente antes de responder
REPLY_DEBOUNCE_SECONDS=8

# ================== WhatsApp ==================
# cloud = API oficial da Meta | evolution = QR Code via Evolution API | none = só simulador
WHATSAPP_PROVIDER=none

# --- API oficial (Meta WhatsApp Cloud API) ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Texto qualquer que você também informa no painel da Meta ao cadastrar o webhook
META_VERIFY_TOKEN=
# "Chave secreta do app" (Configurações do app > Básico) — usada para validar os webhooks
META_APP_SECRET=

# --- Evolution API (QR Code) ---
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=escritorio
# Token que vai na URL do webhook: https://SEU-DOMINIO/webhook/evolution?token=ESTE_TOKEN
EVOLUTION_WEBHOOK_TOKEN=

# Número (com DDI e DDD, só dígitos) que recebe avisos de reunião marcada / pedido de atendimento humano
NOTIFY_WHATSAPP_NUMBER=

# ================== Agenda ==================
TIMEZONE=America/Sao_Paulo
UTC_OFFSET=-03:00
# Google Agenda (opcional): conta de serviço com permissão "Fazer alterações nos eventos" na agenda
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a chave privada em uma linha, com \n no lugar das quebras de linha
GOOGLE_PRIVATE_KEY=
